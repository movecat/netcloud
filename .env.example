INSTALL_MODE=docker

# SSR API/database mode: legendsockssr, sspanelv3, glzjinmod, sspanelv2, mudbjson
API_INTERFACE=legendsockssr
UPDATE_TIME=60
SERVER_PUB_ADDR=127.0.0.1

# MySQL settings used by panel modes.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
NODE_ID=0
TRANSFER_MUL=1.0
ALLOW_EMPTY_DB_PASSWORD=0

# Default SSR parameters.
SSR_METHOD=chacha20
SSR_PROTOCOL=auth_sha1_v4_compatible
SSR_OBFS=tls1.2_ticket_auth_compatible
SSR_PROTOCOL_PARAM=
SSR_OBFS_PARAM=

# This is informational when network_mode=host is used.
PORT_RANGE=10000-20000

# Speed limit. Old script converted Mbps to KB/s by Mbps * 128.
SPEED_LIMIT_MBPS=0
SPEED_LIMIT_KB=

# Single-port multi-user mode.
SINGLE_PORT_MODE=on
SINGLE_PORT=38310
SINGLE_PASSWORD=change-me
SINGLE_METHOD=chacha20
SINGLE_OBFS=tls1.2_ticket_auth
SINGLE_PROTOCOL=auth_aes128_md5
SINGLE_PROTOCOL_PARAM=#

LOGS_SAVE=y
LOGS_SAVE_DAYS=30
NOFILE_LIMIT=51200
